{
  "expo": {
    "name": "Floripa Cupons",
    "slug": "floripa-cupons",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/victor-gadder-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/victor-gadder-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C2622"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.victorgadder.floripacupons",
      "adaptiveIcon": {
        "backgroundColor": "#2C2622",
        "foregroundImage": "./assets/victor-gadder-icon.png",
        "monochromeImage": "./assets/victor-gadder-icon.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/victor-gadder-icon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "94d5110d-8da6-44c1-8251-0b7270876ee0"
      }
    },
    "owner": "victorgadder"
  }
}
